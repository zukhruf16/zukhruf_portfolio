{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
